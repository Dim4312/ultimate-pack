	quest.2E5776191E48B14F.title: "&9Iron's:&r Diamond Spell Book"
	quest.2E621D894EB85167.quest_desc: [
		"Don't get lost."
	]
	quest.2E621D894EB85167.title: "The Labyrinth"
	quest.2EA4CD47217CDB3F.quest_desc: [
