	quest.2F58F09C3B139A1B.title: "&9Magic:&r Evoker Fort"
	quest.2F68436950AF4669.quest_desc: [
		"Fill and empty bottles, buckets and potions automatically."
	]
	quest.2F68436950AF4669.title: "Spouts and Drains"
	quest.2FCC36702D78E8BD.quest_desc: [
