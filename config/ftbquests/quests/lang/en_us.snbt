	]
	quest.2EE4CB3EB84FF245.title: "&9Iron's:&r Scroll Forge"
	quest.2EEA49EF4AC31512.quest_desc: [
		"When Dungeons Arise, IDAS, Towns and Towers, Moog's structures, Structory and more."
	]
	quest.2EEA49EF4AC31512.title: "&eOn the Surface"
	quest.2EEB4F774D3EFAE5.quest_desc: [
