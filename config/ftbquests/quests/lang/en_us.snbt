	]
	quest.292B30122D28BEFA.title: "Shiraz Palace"
	quest.29A64A320A560AC5.quest_desc: [
		"Old, mossy and silent."
	]
	quest.29A64A320A560AC5.title: "Forgotten Forest"
	quest.2A1E02DF42F9544E.quest_desc: [
		"A broken castle of end stone. Its guardian is not broken at all."
	]
	quest.2A1E02DF42F9544E.title: "The Ruined Citadel"
	quest.2A7C0EF5ACFC62A7.quest_desc: [
		"Somebody lives up there."
	]
	quest.2A7C0EF5ACFC62A7.title: "Jungle Tree House"
	quest.2ABF0388C774055A.quest_desc: [
		"Mine faster with your bare hands."
	]
	quest.2ABF0388C774055A.title: "Digging Claws"
	quest.2B2ABA53A2E279AE.quest_desc: [
		"The Leviathan only fights in water. Water breathing, Depth Strider and a conduit help a lot."
		"Its Echo only works while you stand in water."
	]
	quest.2B2ABA53A2E279AE.title: "&cBoss: The Leviathan"
	quest.2B3A833FA8175741.quest_desc: [
		"Half-timbered houses, English style."
	]
	quest.2B3A833FA8175741.title: "A Tudor Village"
	quest.2B92D956815BC6C4.quest_desc: [
		"The frame of the gate. Purpur from the cities, shells from shulkers, pearls from endermen."
	]
	quest.2B92D956815BC6C4.title: "Purpur and Pearls"
	quest.2B9AF7ABD65464A4.quest_desc: [
		"Illagers... on a ship."
	]
	quest.2B9AF7ABD65464A4.title: "Illager Galley"
	quest.2BABCE1E1CE0AFCA.quest_desc: [
		"Mooshrooms and no hostile mobs. A perfect hideout."
	]
	quest.2BABCE1E1CE0AFCA.title: "Mushroom Island"
	quest.2C3658428ED4F62D.quest_desc: [
		"A windmill makes power anywhere, no water needed."
	]
	quest.2C3658428ED4F62D.title: "Wind Power"
	quest.2C42B779AD5E544E.quest_desc: [
		"Reeds, mud and frogs."
	]
	quest.2C42B779AD5E544E.title: "Marsh"
	quest.2C580D63D92BA6FB.quest_desc: [
		"Defeat the Netherite Monstrosity and Ignis."
		""
		"&eReward:&r you learn &6Tempering VII&r and get your first Tempering Kit VII."
		"From now on you can craft that kit and temper any weapon or staff up to level VII."
	]
	quest.2C580D63D92BA6FB.quest_subtitle: "Learn Tempering VII"
	quest.2C580D63D92BA6FB.title: "&6Trial of Phase 7"
	quest.2C727D207E927473.quest_desc: [
		"Pulls items into your backpack."
	]
	quest.2C727D207E927473.title: "Backpack Magnet"
	quest.2C8C2EB497AD4A44.quest_desc: [
		"The strongest power in Create. Boil water on a heated tank."
	]
	quest.2C8C2EB497AD4A44.title: "Steam Engine"
	quest.2CCBAE40FAEE8477.quest_desc: [
		"Blaze rods brew potions and power a real Blaze Burner. You'll need them for Eyes of Ender too."
	]
	quest.2CCBAE40FAEE8477.title: "Blaze Rods"
	quest.2D708A78533599DF.quest_desc: [
		"Roast chestnuts by the fire."
	]
	quest.2D708A78533599DF.title: "Chestnut Forest"
	quest.2DE3874998AEE8D2.quest_desc: [
		"Deployers use items like a player would. Mechanical arms move things around."
