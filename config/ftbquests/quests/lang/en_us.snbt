	]
	quest.371B53B968E6CA34.title: "Illager Imbuing Table"
	quest.3746CF719F3BB8BD.quest_desc: [
		"A tower of books and magic."
	]
	quest.3746CF719F3BB8BD.title: "Wizard Tower"
	quest.37C76DC33C395FEB.quest_desc: [
		"A beach of every color."
	]
	quest.37C76DC33C395FEB.title: "Rainbow Beach"
	quest.37D0E5A084DA15A8.quest_desc: [
		"Build a train. Tracks, a station, and a controls block on a frame of casings."
		"A shared rail network is the backbone of a server. Connect your friends' bases."
