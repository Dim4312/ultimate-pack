	]
	chapter.1A0695D07C9B8A34.title: "&6Treasure & Monsters"
	chapter.23AE929B108DA600.chapter_subtitle: [
		"Settle in. First machines, first fights, first spells."
	]
	chapter.23AE929B108DA600.title: "&a1. Arrival"
	chapter.2AC7F0A329B254B5.chapter_subtitle: [
		"Machines that are fun to build. None of these are required."
	]
	chapter.2AC7F0A329B254B5.title: "&6Create Workshop"
	chapter.2D399535AA66ACA0.chapter_subtitle: [
		"How do we get home?"
	]
	chapter.2D399535AA66ACA0.title: "&d9. The Way Back"
	chapter.2D834A8A479D074E.chapter_subtitle: [
		"Go everywhere. Every biome is a small reward."
	]
	chapter.2D834A8A479D074E.title: "&eDiscoveries: Biomes"
	chapter.3010B3B346EC4BBA.chapter_subtitle: [
		"Good food heals more and keeps you full longer. Cook together."
	]
	chapter.3010B3B346EC4BBA.title: "&eKitchen & Farm"
	chapter.449DAB2CB6AD8451.chapter_subtitle: [
		"The surface is full of places to raid."
	]
	chapter.449DAB2CB6AD8451.title: "&a2. Ruins"
	chapter.4C6955F48943D07D.chapter_subtitle: [
		"Mineshafts, caves, and something ancient below."
	]
	chapter.4C6955F48943D07D.title: "&a3. The Deep"
	chapter.4F28DE7C5403CE63.chapter_subtitle: [
		"The portal only goes one way. Pack well."
	]
	chapter.4F28DE7C5403CE63.title: "&58. One Way"
	chapter.5654CFED2C5B0A2E.chapter_subtitle: [
		"The dragon's island is cut off by the void."
	]
	chapter.5654CFED2C5B0A2E.title: "&d10. The Dragon"
	chapter.5BDFE4FCEA44F862.chapter_subtitle: [
		"A city sank. Something still lives in it."
	]
	chapter.5BDFE4FCEA44F862.title: "&b5. The Sea"
	chapter.6335527ACA7CF750.chapter_subtitle: [
		"Read this first. It takes two minutes."
	]
	chapter.6335527ACA7CF750.title: "&eWelcome"
	chapter.68564AFD461A87C0.chapter_subtitle: [
		"An ancient factory holds the key to the Nether."
	]
	chapter.68564AFD461A87C0.title: "&b6. The Forge"
	chapter.7263A042786D763C.chapter_subtitle: [
		"Fortresses, bastions, and the two fire bosses."
	]
	chapter.7263A042786D763C.title: "&c7. The Fire"
	chapter.74CAB2F3431C59C8.chapter_subtitle: [
		"Expeditions. Pick two of four."
	]
	chapter.74CAB2F3431C59C8.title: "&b4. Far Lands"
	chapter.7959E8373B197341.chapter_subtitle: [
		"Things that make the world nicer to live in."
	]
	chapter.7959E8373B197341.title: "&aLife & Travel"
	chapter.7E6FB5A69DB6172B.chapter_subtitle: [
		"Castles, crypts, ships and towers. Each one has loot for every player."
	]
