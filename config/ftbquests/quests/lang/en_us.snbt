	file.0000000000000001.title: "Ultimate Pack"
	quest.10B7F86C2EE56300.quest_desc: [
		"A castle on the snowy peaks, full of draugr. In its great hall lies a cursed tombstone."
	]
	quest.10B7F86C2EE56300.title: "The Frosted Prison"
	quest.110A8D026B602328.quest_desc: [
		"Feasts are placed on a table and everyone can take a serving. Perfect after a boss fight."
	]
	quest.110A8D026B602328.title: "A Feast"
	quest.112E73FC7E557AEC.quest_desc: [
		"Swim a lot faster."
	]
	quest.112E73FC7E557AEC.title: "Flippers"
	quest.1135663C1DC88357.quest_desc: [
		"The Explorer's Compass finds any structure you pick from a list."
		"Every chest has its own loot for each player (Lootr), so go together or go later, it's all yours."
	]
	quest.1135663C1DC88357.title: "&eThe Explorer's Compass"
	quest.113D66B7721EAAB3.quest_desc: [
		"Step on one, appear at the other."
	]
	quest.113D66B7721EAAB3.title: "Warp Plates"
	quest.116573CF05013094.quest_desc: [
		"A water wheel turns flowing water into rotation. Rotation powers everything in Create."
	]
	quest.116573CF05013094.title: "&6Create:&r Power"
	quest.12596558C60C6F56.quest_desc: [
		"Halloween, but it's a biome."
	]
	quest.12596558C60C6F56.title: "Pumpkin Valley"
	quest.12E11CEE2DA99419.quest_desc: [
		"An arena of fire, deep in the Nether. At its heart is the &eAltar of Fire&r."
		"Ignis sleeps until the altar is lit... or until someone uses an &dEcho of Ignis&r."
	]
	quest.12E11CEE2DA99419.title: "The Burning Arena"
	quest.131D76EAFF84CE00.quest_desc: [
		"Everything Ars Nouveau can do."
	]
	quest.131D76EAFF84CE00.title: "&dArs:&r Archmage Spell Book"
	quest.132B5284D108AD23.quest_desc: [
		"Atop the Acropolis waits Scylla, a storm queen. Optional, but glorious."
	]
	quest.132B5284D108AD23.title: "&5Optional: Scylla"
	quest.1380EAF0EAE47745.quest_desc: [
		"Ring it to see where mobs can spawn."
	]
	quest.1380EAF0EAE47745.title: "Haunted Bell"
	quest.13C6C24E75346738.quest_desc: [
		"Houses inside giant mushrooms."
	]
	quest.13C6C24E75346738.title: "Mushroom Village"
	quest.13DA8590AB7495A1.quest_desc: [
		"Craft the big recipes automatically."
	]
	quest.13DA8590AB7495A1.title: "Mechanical Crafters"
	quest.1411F78FB4F206F0.quest_desc: [
		"&eJEI&r (item list on the right): hover an item and press &eR&r for its recipe or &eU&r for its uses."
		"&ePonder&r: hold &eW&r while hovering any Create item to see an animated guide."
		"&eJade&r shows what you are looking at, at the top of the screen."
		"&eWaystones&r: find them in villages or craft them to travel between places you've been."
	]
	quest.1411F78FB4F206F0.title: "Lost? JEI and Ponder"
	quest.1473BAEDC00EB5EA.quest_desc: [
		"A huge stone church."
	]
	quest.1473BAEDC00EB5EA.title: "The Cathedral"
	quest.148B8F0EAF856AD1.quest_desc: [
		"Umvuthi calls the sun down on you. Kill the followers first, and don't stand in the light."
	]
	quest.148B8F0EAF856AD1.title: "&cBoss: Umvuthi"
	quest.14BD8FDC04C495B1.quest_desc: [
		"Incendium's castles and more."
	]
	quest.14BD8FDC04C495B1.title: "&cIn the Nether"
	quest.14D3FF661FAB76A6.quest_desc: [
		"Show train times, stock levels or a message for your friends."
	]
	quest.14D3FF661FAB76A6.title: "Display Boards"
	quest.14F845F787B56A05.quest_desc: [
		"The pirate captain of the Ice Maze."
	]
	quest.14F845F787B56A05.title: "Captain Cornelia"
	quest.15438C6D1BD94F7D.quest_desc: [
		"Trees hanging from the ceiling."
	]
	quest.15438C6D1BD94F7D.title: "Inverted Forest"
	quest.155DDC016A303CB8.quest_desc: [
		"Japanese cedars and quiet paths."
	]
	quest.155DDC016A303CB8.title: "Sugi Forest"
	quest.159D230F9126550C.quest_desc: [
		"Burning sand dunes."
	]
	quest.159D230F9126550C.title: "Infernal Dunes"
	quest.15AA66EC3A51C8CD.quest_desc: [
		"A fortress in the sky. Bring slow falling."
	]
	quest.15AA66EC3A51C8CD.title: "Heavenly Conqueror"
	quest.15BC15E59B2C215F.quest_desc: [
		"YUNG's fortresses are huge: halls, bridges, a whole keep. Blazes and wither skeletons live here."
	]
	quest.15BC15E59B2C215F.title: "Nether Fortress"
	quest.16816ACA93EFD583.quest_desc: [
		"Upgrade your mage armor at the arcane anvil."
	]
	quest.16816ACA93EFD583.title: "&9Iron's:&r Upgrade Orbs"
	quest.168D7F9DF13FB23C.quest_desc: [
		"He rides a dark horse on Halloween nights... and other nights."
	]
	quest.168D7F9DF13FB23C.title: "Lord Pumpkinhead"
	quest.173BC39D72488FFA.quest_desc: [
		"Welcome to the End. Everyone who comes through the portal lands here, on this same island."
		"Build a base. You'll be here for a while."
	]
	quest.173BC39D72488FFA.title: "A New World"
	quest.176A35EE0A40251D.quest_desc: [
		"Guardians, elder guardians and gold. Bring milk for mining fatigue."
	]
	quest.176A35EE0A40251D.title: "Ocean Monument"
	quest.1779A290EA6A2A77.quest_desc: [
		"It smells nice. Probably."
	]
	quest.1779A290EA6A2A77.title: "Lavender Fields"
	quest.1788E5E2327DE5FC.quest_desc: [
		"A fortress of tricks."
	]
	quest.1788E5E2327DE5FC.title: "Illusioner Citadel"
	quest.17D686186D44D1A1.quest_desc: [
		"Grey ash as far as you can see."
	]
	quest.17D686186D44D1A1.title: "Ash Barrens"
	quest.185F99AFF658C69A.quest_desc: [
		"Rituals change the weather, the time of day and more."
	]
	quest.185F99AFF658C69A.title: "&dArs:&r Rituals"
	quest.18892417FC79295C.quest_desc: [
		"In the soul sand valleys stands an old forge. Its smith never stopped working."
	]
	quest.18892417FC79295C.title: "The Soul Black Smith"
	quest.1896D26D699DD437.quest_desc: [
		"More slots for more spells."
	]
	quest.1896D26D699DD437.title: "&9Iron's:&r Iron Spell Book"
	quest.189BE9117D277051.quest_desc: [
		"Bones and treasure."
	]
	quest.189BE9117D277051.title: "Ancient Crypt"
	quest.189F3CD689F8BD7B.quest_desc: [
		"Organic compost turns into Rich Soil, which makes crops grow faster."
	]
	quest.189F3CD689F8BD7B.title: "Rich Soil"
	quest.18E8E443386B66D4.quest_desc: [
		"Molten metal and the people who guard it."
	]
	quest.18E8E443386B66D4.title: "The Foundry"
	quest.19897C91C7CD5DA8.quest_desc: [
		"Show that you can build and fight."
		"Have 16 Andesite Alloy, and take down 3 creepers before they take down your base."
		""
		"&eReward:&r you learn &6Tempering I&r and get your first Tempering Kit I."
		"From now on you can craft that kit and temper any weapon or staff up to level I."
	]
	quest.19897C91C7CD5DA8.quest_subtitle: "Learn Tempering I"
	quest.19897C91C7CD5DA8.title: "&6Trial of Phase 1"
	quest.19B191D7E1743B4B.quest_desc: [
		"&bFrostmaw&r roams the ice spikes and snowy plains, sleeping until disturbed."
	]
	quest.19B191D7E1743B4B.title: "The Frozen North"
	quest.1A15553EB1954929.quest_desc: [
		"Stepped pools in red stone."
	]
	quest.1A15553EB1954929.title: "Ironwood Gour"
	quest.1A16A9A1908AA09D.quest_desc: [
		"A ship that sails the void."
	]
	quest.1A16A9A1908AA09D.title: "Starlight Voyager"
	quest.1A276C59CF3B9A62.quest_desc: [
		"Nap through the day."
	]
	quest.1A276C59CF3B9A62.title: "Hammock"
	quest.1A5C5FA8AB5BC10A.quest_desc: [
		"When you die, a gravestone keeps your items. Only you can open it."
	]
	quest.1A5C5FA8AB5BC10A.title: "Grave Matters"
	quest.1A9B7B777A8C0574.quest_desc: [
		"Claim your land with FTB Chunks (open the map with &eM&r and drag over chunks): nobody can grief it."
		"Talk with proximity voice chat (Simple Voice Chat, key &eV&r to configure)."
	]
	quest.1A9B7B777A8C0574.title: "&aHome Sweet Home"
	quest.1AA5CF1F0E37E97A.quest_desc: [
		"Send packages across your base on chains."
	]
	quest.1AA5CF1F0E37E97A.title: "Chain Conveyors"
	quest.1B0633362A46DC76.quest_desc: [
		"A knight of living fire with a sword and a shield. Three phases, each angrier than the last."
		"&6When Ignis falls for the first time, the End opens for everyone.&r"
	]
	quest.1B0633362A46DC76.title: "&cBoss: Ignis"
	quest.1B710BC9020BF7DE.quest_desc: [
		"Spin it."
	]
	quest.1B710BC9020BF7DE.title: "A Globe"
	quest.1B929428B2854DF9.quest_desc: [
		"A piglin castle full of gold, and full of piglin brutes. Their chests hold netherite scraps."
	]
	quest.1B929428B2854DF9.title: "Bastion Remnant"
	quest.1C173F21C41AB355.quest_desc: [
		"Old stones, older secrets."
	]
	quest.1C173F21C41AB355.title: "Ancient Ruins"
	quest.1C1CC9EE267F3BBF.quest_desc: [
		"Three wither skeleton skulls and four soul sand. Build it far away from your base."
		"Its Nether Star makes a beacon."
	]
	quest.1C1CC9EE267F3BBF.title: "&5Optional: The Wither"
	quest.1C3CB1B679C70DD9.quest_desc: [
		"Dead trees and wither skeletons."
	]
	quest.1C3CB1B679C70DD9.title: "Withered Forest"
	quest.1C3EEA688E04645A.quest_desc: [
		"&6One world. Play together. Create, don't grind."
		""
		"The book is split into &aPhases&r. Each Phase sends you somewhere new and ends with a &6Trial&r."
		"Beating a Trial teaches you the next level of &6Tempering&r, the only power upgrade in the pack."
		""
		"There are only three worlds: the &2Overworld&r, the &cNether&r and the &5End&r."
		"The Nether and the End start &csealed&r. You open them together, for the whole server, by beating bosses."
		""
		"Not in the mood for the story? The &eSide Quests&r chapters (biomes, dungeons, cooking, magic, gear) are all optional."
	]
	quest.1C3EEA688E04645A.title: "&eWelcome to Ultimate Pack"
	quest.1C4C9AC5ACB69C6D.quest_desc: [
		"Undead guard their master's tower."
	]
	quest.1C4C9AC5ACB69C6D.title: "Necromancer's Spire"
	quest.1C4E6474036F2D95.quest_desc: [
		"Visit a village. Trade, find a waystone, and ask yourself: where do all those ruins lead?"
	]
	quest.1C4E6474036F2D95.title: "The World Beyond"
	quest.1C87535087485878.quest_desc: [
		"Jagged basalt and magma cubes."
	]
	quest.1C87535087485878.title: "Basalt Deltas"
	quest.1C8F94F469BBC0A2.quest_desc: [
		"Knives slice food and get extra drops (leather, ham) from animals."
	]
	quest.1C8F94F469BBC0A2.title: "A Kitchen Knife"
	quest.1CCC633B15A78AC2.quest_desc: [
		"&9Ars Nouveau&r is the other magic: you design spells yourself from glyphs."
		"Read the Worn Notebook for a full guide. Totally optional, totally fun."
	]
	quest.1CCC633B15A78AC2.title: "&9Magic:&r Ars Nouveau"
	quest.1CE8753C3B2548BD.quest_desc: [
		"There were other dragons once."
	]
	quest.1CE8753C3B2548BD.title: "Dragon Skeleton"
	quest.1D0C36F3C14B99EA.quest_desc: [
		"Wooden towers full of bandits and their loot."
	]
	quest.1D0C36F3C14B99EA.title: "Bandit Towers"
	quest.1D7E99F9E2A05832.quest_desc: [
		"More space, more upgrades."
	]
	quest.1D7E99F9E2A05832.title: "Bigger Backpack"
	quest.1D9B52BEACC805AA.quest_desc: [
		"Fight your way through the arena."
	]
	quest.1D9B52BEACC805AA.title: "The Coliseum"
	quest.1EE68DDE8C6B2590.quest_desc: [
		"A Nature's Compass points to any biome you pick. Try it."
		"There are more than a hundred biomes in this pack. You don't have to find them all... but you could."
	]
	quest.1EE68DDE8C6B2590.title: "&eThe Explorer's Kit"
	quest.1EF1D88B99828495.quest_desc: [
		"Dark, dense and a bit creepy."
	]
	quest.1EF1D88B99828495.title: "Black Forest"
	quest.1F0DF0760248002B.quest_desc: [
		"Buried treasure maps lead to the Heart of the Sea. With it, build a conduit and breathe underwater."
	]
	quest.1F0DF0760248002B.title: "Set Sail"
	quest.1F0F0620D6AC14FF.quest_desc: [
		"Mines, crypts and chambers."
	]
	quest.1F0F0620D6AC14FF.title: "&eUnder the Ground"
	quest.1F2DAFCA5304583E.quest_desc: [
		"Islands in the sky. How?"
	]
	quest.1F2DAFCA5304583E.title: "Floating Islands"
	quest.1F36A6722656F796.quest_desc: [
		"Moog's End Structures, Nullscape and more."
	]
	quest.1F36A6722656F796.title: "&5In the End"
	quest.1F56FEA91F7D9E3F.quest_desc: [
		"A fan through lava smelts, through fire smokes, through water washes."
	]
	quest.1F56FEA91F7D9E3F.title: "Bulk Processing"
	quest.1F6D54BDBC1A17E0.quest_desc: [
		"Move items around your base. Use dried kelp, it's the recipe."
	]
	quest.1F6D54BDBC1A17E0.title: "Conveyor Belts"
	quest.1F6E734F4E5D9A4B.quest_desc: [
		"Brew potions and break down scrolls into ink."
	]
	quest.1F6E734F4E5D9A4B.title: "&9Iron's:&r Alchemist Cauldron"
	quest.1FA52EB91E716014.quest_desc: [
		"Purple towers full of shulkers. Some have a ship floating next to them."
		"Remember the ships. They matter later."
	]
	quest.1FA52EB91E716014.title: "End City"
	quest.2000F5C83EEDFD97.quest_desc: [
		"Deep under the ground lies a factory of the old world. Its guardian, &cthe Harbinger&r, is dormant."
		"Normally you need a Nether Star to wake it, but the Nether is sealed."
		"Instead, right-click it with an &dEcho of The Harbinger&r."
	]
	quest.2000F5C83EEDFD97.title: "The Ancient Factory"
	quest.207432745E2C0690.quest_desc: [
		"Broken ice and deep cracks."
	]
	quest.207432745E2C0690.title: "Shattered Glacier"
	quest.20B48BBB846068E6.quest_desc: [
		"Teleports, punches, and throws void runes. Watch the ground for purple marks and move."
		"&dWhoever helps beat it can wake a Return Gate.&r"
	]
	quest.20B48BBB846068E6.title: "&cBoss: Ender Guardian"
	quest.20BF905D9DB02C51.quest_desc: [
		"Call it with a ritual. Hunters, stalkers and guardians all in one."
	]
	quest.20BF905D9DB02C51.title: "&dArs:&r &5The Wilden Chimera"
	quest.21373C5E1185A5D0.quest_desc: [
		"The dragon's island is about a thousand blocks of empty void away."
		"Near it, wings stop working. Pearls don't reach. You need something bigger."
	]
	quest.21373C5E1185A5D0.title: "Cut Off"
	quest.21BF4BB51834B3E5.quest_desc: [
		"Dungeons hide under the ground: catacombs of zombies, skeletons and spiders."
		"Each player gets their own loot from every chest, so share the hunt."
	]
	quest.21BF4BB51834B3E5.title: "Into the Dungeon"
	quest.2233DB7D480197A6.quest_desc: [
		"On a mountain monastery a sculptor challenges you to climb his pillar while he attacks."
		"A puzzle fight. Optional, but nobody forgets it."
	]
	quest.2233DB7D480197A6.title: "&5Optional: The Sculptor"
	quest.22EEDACACBA08A26.quest_desc: [
		"Ancient debris hides deep in the Nether at about Y 15. Four scraps and four gold make one ingot."
		"Use a smithing table and a netherite upgrade template (bastions have them)."
	]
	quest.22EEDACACBA08A26.title: "Netherite"
	quest.23D721B1896E13E3.quest_desc: [
		"Fir trees on high meadows."
	]
	quest.23D721B1896E13E3.title: "Alpine Highlands"
	quest.23FE46A28DC64A31.quest_desc: [
		"Lava rivers between black rock."
	]
	quest.23FE46A28DC64A31.title: "Volcanic Deltas"
	quest.241EB30666DD35B1.quest_desc: [
		"Born in Chaos's monsters drop it. Their gear is nasty."
	]
	quest.241EB30666DD35B1.title: "Dark Metal"
	quest.24394B3692BEF64B.quest_desc: [
		"A shining white plain."
	]
	quest.24394B3692BEF64B.title: "Quartz Flats"
	quest.2460BDF3EBBAC3E2.quest_desc: [
		"Teleport to any waystone you know, once."
	]
	quest.2460BDF3EBBAC3E2.title: "Warp Scroll"
	quest.2468348D8AF7EB70.quest_desc: [
		"Quiet halls high in the mountains."
	]
	quest.2468348D8AF7EB70.title: "The Monastery"
	quest.2473F23F2D16F00C.quest_desc: [
		"Somewhere in a cursed catacomb, a king still sits on his throne."
	]
	quest.2473F23F2D16F00C.title: "&9Iron's:&r &5The Dead King"
	quest.24B890D5B9E2BEA8.quest_desc: [
		"Pale mangroves in shallow water."
	]
	quest.24B890D5B9E2BEA8.title: "White Mangrove Marshes"
	quest.24C4D4A900D6B847.quest_desc: [
		"Towers grown over with thorns."
	]
	quest.24C4D4A900D6B847.title: "Thornborn Towers"
	quest.25253F12D398380F.quest_desc: [
		"Food, drink and a bed for the night (Dungeons and Taverns)."
	]
	quest.25253F12D398380F.title: "A Tavern"
	quest.254546620A7C9A3D.quest_desc: [
		"The greatest of the evoker mages."
	]
	quest.254546620A7C9A3D.title: "&9Iron's:&r &5The Archevoker"
	quest.25B6B1D4E06FABDF.quest_desc: [
		"A press flattens ingots into sheets. A millstone grinds ores and crops."
		"Ores ground up give extra ingots. Automation starts paying off right away."
	]
	quest.25B6B1D4E06FABDF.title: "&6Create:&r First Machines"
	quest.25D576DEFC643967.quest_desc: [
		"Machines, gears and a very busy tinkerer."
	]
	quest.25D576DEFC643967.title: "Tinker's Citadel"
	quest.26045AE94C6082E0.quest_desc: [
		"There are no classes. Pick up a sword &oand&r a spellbook."
		""
		"&cWeapons:&r Simply Swords, Better Combat (combos, dual wield), Combat Roll (dodge with &eR&r)."
		"&9Magic:&r Iron's Spells 'n Spellbooks (find scrolls, inscribe them into a spellbook)"
		"and Ars Nouveau (design your own spells)."
		""
		"Every Phase gives a weapon goal and a magic goal. Lean wherever you like, and change your mind any time."
	]
	quest.26045AE94C6082E0.title: "Everyone fights, everyone casts"
	quest.2606DD79023983B0.quest_desc: [
		"Catch it in bottles while the dragon breathes. Tempering Kit X needs it, so grab plenty."
	]
	quest.2606DD79023983B0.title: "Dragon's Breath"
	quest.261533C08D853A62.quest_desc: [
		"Engineer's Goggles show the stress and speed of your machines."
		"Hold &eW&r over any Create item for a Ponder scene."
	]
	quest.261533C08D853A62.title: "&6The Workshop"
	quest.2619F3C6074A725C.quest_desc: [
		"Shulker boxes keep your stuff organized, and the End's Tempering Kits need shells."
	]
	quest.2619F3C6074A725C.title: "Shulker Shells"
	quest.268E0DCA5F2228B2.quest_desc: [
		"Defeat the Ender Dragon."
		"You've done it: all ten Phases. Tempering X is yours."
		"&dThe Dragon's Echo&r (End raids and dragon pacts) is coming in a future update."
		""
		"&eReward:&r you learn &6Tempering X&r and get your first Tempering Kit X."
		"From now on you can craft that kit and temper any weapon or staff up to level X."
	]
	quest.268E0DCA5F2228B2.quest_subtitle: "Learn Tempering X"
	quest.268E0DCA5F2228B2.title: "&6Trial of Phase 10"
	quest.26958AC16C592360.quest_desc: [
		"The crew is still on board."
	]
	quest.26958AC16C592360.title: "Undead Pirate Ship"
	quest.269DDFD61A743584.quest_desc: [
		"Cook a stew in the pot. Bowls go in the bottom slot."
	]
	quest.269DDFD61A743584.title: "A Proper Meal"
	quest.26C89AD3A6E4BF2E.quest_desc: [
		"Source powers everything in Ars Nouveau."
	]
	quest.26C89AD3A6E4BF2E.title: "&dArs:&r Source Jar"
	quest.2736256921B527F5.quest_desc: [
		"Do you really want to? Optional. Very optional."
	]
	quest.2736256921B527F5.title: "The Warden"
	quest.284A53888BB162C2.quest_desc: [
		"What's left of a castle."
	]
	quest.284A53888BB162C2.title: "Castle Ruins"
	quest.2892D80CF8DE2C00.quest_desc: [
		"Something moves under the ground."
	]
	quest.2892D80CF8DE2C00.title: "Undead Crypt"
	quest.28A147AB52E53677.quest_desc: [
		"A great ice beast. Stay away from its breath, use fire, and keep moving."
	]
	quest.28A147AB52E53677.title: "&cBoss: Frostmaw"
	quest.2901DAD22DC33E8F.quest_desc: [
		"A whole underground mine, carts and all."
	]
	quest.2901DAD22DC33E8F.title: "Mining System"
	quest.2905922F04002C1F.quest_desc: [
		"With Create Central Kitchen, a mixer and a heated basin cook Farmer's Delight pot recipes on their own."
