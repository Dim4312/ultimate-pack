	quest.450FABCC58B14E95.title: "The Deep Dark"
	quest.451DA2C4BBACE0BD.quest_desc: [
		"Defeat the Ender Guardian."
		""
		"&eReward:&r you learn &6Tempering VIII&r and get your first Tempering Kit VIII."
		"From now on you can craft that kit and temper any weapon or staff up to level VIII."
	]
	quest.451DA2C4BBACE0BD.quest_subtitle: "Learn Tempering VIII"
	quest.451DA2C4BBACE0BD.title: "&6Trial of Phase 8"
	quest.4520797F0A530CA9.quest_desc: [
		"A tall spire into the dark."
	]
	quest.4520797F0A530CA9.title: "Ender Spire"
	quest.4520D8B574C5D64B.quest_desc: [
		"A fortress rising out of the waves."
	]
	quest.4520D8B574C5D64B.title: "Ocean Fortress"
