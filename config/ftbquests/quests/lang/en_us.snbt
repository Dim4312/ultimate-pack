		"Pink trees in the mountains."
	]
	quest.466F5743E5002F69.title: "Cherry Grove"
	quest.469FE8BE01847132.quest_desc: [
		"You'll hear it before you see it."
	]
	quest.469FE8BE01847132.title: "Haunted Manor"
