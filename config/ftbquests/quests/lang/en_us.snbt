		"Two magic mods, no classes. Iron's Spells is about finding and upgrading spells,"
		"Ars Nouveau is about building your own."
	]
	quest.475488349CEDBA22.title: "&9The Study"
	quest.47CF82538833F521.quest_desc: [
		"Red fungus trees and hoglins."
	]
	quest.47CF82538833F521.title: "Crimson Forest"
	quest.48760F6D731A85AE.quest_desc: [
		"Piglins have towns too."
	]
	quest.48760F6D731A85AE.title: "Piglin Village"
	quest.4940ABD7981D2CD3.quest_desc: [
		"Thin islands floating over nothing."
	]
	quest.4940ABD7981D2CD3.title: "Void Barrens"
	quest.494F0B0748942A74.quest_desc: [
		"A pub up in the trees. First round's on you."
	]
	quest.494F0B0748942A74.title: "Treetop Tavern"
	quest.49790207FC98980E.quest_desc: [
		"The best stuff is underground. Find diamonds, and bring torches."
	]
	quest.49790207FC98980E.title: "Going Down"
	quest.499F47C323510404.quest_desc: [
		"A rich illager family lives here. Not for long."
	]
	quest.499F47C323510404.title: "Illager Manor"
	quest.4AF25645677BE536.quest_desc: [
		"A castle courtyard on an outer island."
	]
	quest.4AF25645677BE536.title: "Enderkeep Courtyard"
	quest.4B7B1D1ED3ABE131.quest_desc: [
		"Back to your bound waystone."
	]
	quest.4B7B1D1ED3ABE131.title: "Return Scroll"
	quest.4B7DF60BF4C1C75F.quest_desc: [
		"Defeat the Ferrous Wroughtnaut and reach an Ancient City."
		""
		"&eReward:&r you learn &6Tempering III&r and get your first Tempering Kit III."
		"From now on you can craft that kit and temper any weapon or staff up to level III."
	]
	quest.4B7DF60BF4C1C75F.quest_subtitle: "Learn Tempering III"
	quest.4B7DF60BF4C1C75F.title: "&6Trial of Phase 3"
	quest.4B84F3D4C0026FFD.quest_desc: [
		"Craft magical items on pedestals."
	]
	quest.4B84F3D4C0026FFD.title: "&dArs:&r Enchanting Apparatus"
	quest.4BF9CC7B93EEECE0.quest_desc: [
		"Nullscape reshapes the outer End: peaks, shadows and barrens."
	]
	quest.4BF9CC7B93EEECE0.title: "&5The End's Biomes"
	quest.4C081E9D4761F2B9.quest_desc: [
		"The sand king and his sandstorms. Keep your distance from the charge."
	]
	quest.4C081E9D4761F2B9.title: "&cBoss: Ancient Remnant"
	quest.4C41865109D7A059.quest_desc: [
		"Ships, lighthouses and fortresses on the water."
	]
	quest.4C41865109D7A059.title: "&bOut at Sea"
	quest.4C4F3F29FF6FF2E6.quest_desc: [
		"Deep under the mountains there is a sealed iron room."
		"Something huge waits inside, wearing iron armor."
	]
	quest.4C4F3F29FF6FF2E6.title: "The Wrought Chamber"
	quest.4CB5710DAEFAD7E7.quest_desc: [
		"A mountain keep. Climb all the way up."
	]
	quest.4CB5710DAEFAD7E7.title: "Keep Kayra"
	quest.4D37D3F99A7A7793.quest_desc: [
		"&9Iron's Spells:&r spells are found as &oscrolls&r in chests and from wizards."
		"Put a scroll into your spellbook at the Inscription Table to learn it for good."
		"Cast with the spell wheel (default &eV&r) and the cast key (default &eR&r, rebind if it clashes with dodge)."
	]
	quest.4D37D3F99A7A7793.title: "&9Magic:&r A Spellbook"
	quest.4EB8075860107567.quest_desc: [
		"&cThe Ferrous Wroughtnaut&r only takes damage when struck &efrom behind&r."
		"Dodge its swings, wait until it gets its axe stuck, then hit its back."
		"Everyone within 64 blocks gets credit."
	]
	quest.4EB8075860107567.title: "&cBoss: Ferrous Wroughtnaut"
	quest.4F01DEC6875E0B9D.quest_desc: [
		"Bows, spells, anything that reaches. No crystals, no healing."
	]
	quest.4F01DEC6875E0B9D.title: "No More Healing"
	quest.4F2EF97B53B2E551.quest_desc: [
		"That chest had teeth."
	]
	quest.4F2EF97B53B2E551.title: "Not a Chest"
	quest.4F4B32F79DD288AD.quest_desc: [
		"The dragon's death opens small gateways at the edge of its island. They lead to the far islands."
	]
	quest.4F4B32F79DD288AD.title: "Beyond"
	quest.4FECCE9110E31F0E.quest_desc: [
		"Even more slots."
	]
	quest.4FECCE9110E31F0E.title: "&9Iron's:&r Gold Spell Book"
	quest.4FF198B2E187FFDF.quest_desc: [
		"Spiky terracotta towers. Gold in the mineshafts."
	]
	quest.4FF198B2E187FFDF.title: "Eroded Badlands"
	quest.5048A79E3C8BDF23.quest_desc: [
		"Wild crops grow all over the world. Break them for seeds."
	]
	quest.5048A79E3C8BDF23.title: "The Garden"
	quest.5075BAA598827ACC.quest_desc: [
		"&6Create&r lets you build machines out of moving parts."
		"Andesite Alloy is the start of it all. Mix andesite with iron nuggets (or zinc)."
		"Hold &eW&r over any Create item to see a Ponder scene."
	]
	quest.5075BAA598827ACC.title: "&6Create:&r Andesite Alloy"
	quest.5219AB5B1627DEF6.quest_desc: [
		"Glow berries and azalea, deep under the ground."
	]
	quest.5219AB5B1627DEF6.title: "Lush Caves"
	quest.529E6ED4C7D6E0A3.quest_desc: [
		"A holy place of fire."
	]
	quest.529E6ED4C7D6E0A3.title: "The Sanctum"
	quest.530B6C339ACBAFDC.quest_desc: [
		"Iron is what everything else is built from: tools, armor, machines, spellbooks."
	]
	quest.530B6C339ACBAFDC.title: "Iron Age"
	quest.53CBEC8BD54F35FE.quest_desc: [
		"The nights are dangerous. Learn how your weapon swings (Better Combat) and how to dodge (&eR&r)."
	]
	quest.53CBEC8BD54F35FE.title: "Night Watch"
	quest.54178B3005D9EE4C.quest_desc: [
		"Incendium adds eight new Nether biomes. Bring fire resistance."
	]
	quest.54178B3005D9EE4C.title: "&cThe Nether's Biomes"
	quest.54E739CA15514105.quest_desc: [
		"Age milk in a cask into a wheel of cheese."
	]
	quest.54E739CA15514105.title: "Say Cheese"
	quest.54EAF44C13BDB4AC.quest_desc: [
		"Bountiful Fares adds fruit trees, teas and a gristmill for flour."
	]
	quest.54EAF44C13BDB4AC.title: "The Orchard"
	quest.551571EF7628178A.quest_desc: [
		"Red stone canyons."
	]
	quest.551571EF7628178A.title: "Red Rock Valley"
	quest.55B092D6B97652CB.quest_desc: [
		"Wine gets better the longer it ages."
	]
	quest.55B092D6B97652CB.title: "Fine Wine"
	quest.55B7A018221C548A.quest_desc: [
		"With Echo Shards you can craft &dBoss Echoes&r and fight any quest boss again."
	]
	quest.55B7A018221C548A.title: "&dEcho Shards"
	quest.55E73BE5BE61637A.quest_desc: [
		"It didn't make it home."
	]
	quest.55E73BE5BE61637A.title: "Sunken Ship"
	quest.5600AD939E279233.quest_desc: [
		"&cThe End is a one-way trip.&r Nothing takes you back: no portal, no waystone. Only dying does."
		"You won't land next to the dragon. The portal throws you onto an outer island, far away from it."
		""
		"Bring: food and seeds, a water bucket, tools, lots of blocks, torches, Create parts."
		"Beds explode in the End. If you die, your items wait in a &egrave&r where you fell, and the portal still takes you back there."
		"Go together. The first group builds the base everyone else lands in."
	]
	quest.5600AD939E279233.title: "&cRead this before you jump"
	quest.5611F33D7BC349EA.quest_desc: [
		"Something huge lives under the frozen sea."
	]
	quest.5611F33D7BC349EA.title: "Maze Mother"
	quest.56F524B1A25C56C0.quest_desc: [
		"Autumn, all year round."
	]
	quest.56F524B1A25C56C0.title: "Maple Woodlands"
	quest.58213E8CF889A2A5.quest_desc: [
		"Wake the Return Gate (right-click it as someone who beat the Ender Guardian), then use it."
		"&dThis happens once, for the whole server:&r from now on the gate takes anyone home,"
		"and the stronghold portal brings anyone straight to the gate."
		"Late joiners: just right-click an awake gate to finish this Trial."
		""
		"&eReward:&r you learn &6Tempering IX&r and get your first Tempering Kit IX."
		"From now on you can craft that kit and temper any weapon or staff up to level IX."
	]
	quest.58213E8CF889A2A5.quest_subtitle: "Learn Tempering IX"
	quest.58213E8CF889A2A5.title: "&6Trial of Phase 9"
	quest.582FB1C842F07D0A.quest_desc: [
		"A drowned city full of deeplings. At its heart is the Altar of the Abyss."
	]
	quest.582FB1C842F07D0A.title: "The Sunken City"
	quest.5871D2B9A1CAB289.quest_desc: [
		"Chorus fruit grows on the islands. Pop it in a furnace. End's Delight turns chorus, shulkers"
		"and even endermites into real meals."
	]
	quest.5871D2B9A1CAB289.title: "Food in the Void"
	quest.58BA63127A90D3B0.quest_desc: [
		"The blazes' queen. Her crown is a trophy."
	]
	quest.58BA63127A90D3B0.title: "The Wildfire"
	quest.58D1183CF5827A00.quest_desc: [
		"An empty manor at the edge of the woods."
	]
	quest.58D1183CF5827A00.title: "Old Manor"
	quest.58F8A0E1841FD10D.quest_desc: [
		"Simply Swords' runic weapons get a random power from these."
	]
	quest.58F8A0E1841FD10D.title: "Runic Tablet"
	quest.59676C65F219B40C.quest_desc: [
		"Rare and strong. Look deep underground for mithril ore."
	]
	quest.59676C65F219B40C.title: "&9Iron's:&r Mithril"
	quest.5975AFCD3286C6A9.quest_desc: [
		"Swamp water, cypress trees and fireflies."
	]
	quest.5975AFCD3286C6A9.title: "Bayou"
	quest.599E3586929EFE1D.quest_desc: [
		"Every school has its own armor: fire, ice, lightning, holy, ender, blood, evocation..."
	]
	quest.599E3586929EFE1D.title: "&9Iron's:&r Pyromancer Robes"
	quest.59F9AC50E3F26A76.quest_desc: [
		"A little helper that carries items between chests."
	]
	quest.59F9AC50E3F26A76.title: "&dArs:&r A Starbuncle Friend"
	quest.5A0DCA1967A047CE.quest_desc: [
		"Someone built an airship before you did."
	]
	quest.5A0DCA1967A047CE.title: "A Lost Blimp"
	quest.5A3349BF54E081E8.quest_desc: [
		"Move water, lava, honey and more."
	]
	quest.5A3349BF54E081E8.title: "Pipes and Pumps"
	quest.5AF002ECC54330A5.quest_desc: [
		"Let a cannon build your schematics."
	]
	quest.5AF002ECC54330A5.title: "Schematicannon"
	quest.5BDBDFA1690B905C.quest_desc: [
		"Witches live here. Don't touch the pots."
	]
	quest.5BDBDFA1690B905C.title: "Weeping Witch Forest"
	quest.5C2BB606D61719AE.quest_desc: [
		"The old miners left rails, chests and cave spiders behind."
	]
	quest.5C2BB606D61719AE.title: "Abandoned Mineshafts"
	quest.5D1A0BC9FD8E76AD.quest_desc: [
		"Green apple trees on misty hills."
	]
	quest.5D1A0BC9FD8E76AD.title: "Skyris Vale"
	quest.5EAE0F3E883289D1.quest_desc: [
		"Defeat the Leviathan."
		""
		"&eReward:&r you learn &6Tempering V&r and get your first Tempering Kit V."
		"From now on you can craft that kit and temper any weapon or staff up to level V."
	]
	quest.5EAE0F3E883289D1.quest_subtitle: "Learn Tempering V"
	quest.5EAE0F3E883289D1.title: "&6Trial of Phase 5"
	quest.5EFC6A1A1DDEEC55.quest_desc: [
		"Illager Invasion's metal, for platinum tools."
	]
	quest.5EFC6A1A1DDEEC55.title: "Platinum"
	quest.5F12D1208183EC82.quest_desc: [
		"YUNG's strongholds are big and full of traps. The portal room is at the bottom."
	]
	quest.5F12D1208183EC82.title: "The Stronghold"
	quest.5F6F1EDDB10F8C9F.quest_desc: [
		"Loot is per player, so every chest is worth opening."
		"Artifacts hide in chests and in &cmimics&r (chests that bite)."
	]
	quest.5F6F1EDDB10F8C9F.title: "&6Treasure Hunter"
	quest.5F767CC7399FCF8D.quest_desc: [
		"Glowing mushrooms in the dark."
	]
	quest.5F767CC7399FCF8D.title: "Mushroom Mines"
	quest.5FB8F2A9A154FF78.quest_desc: [
		"A walking furnace of netherite and lava. It hits like a mountain and throws lava."
		"Fire resistance is a must. Hit it after its slam, then get out of the way."
	]
	quest.5FB8F2A9A154FF78.title: "&cBoss: Netherite Monstrosity"
	quest.6012C7596482A2FB.quest_desc: [
		"A tomb on the surface."
	]
	quest.6012C7596482A2FB.title: "Mausoleum"
	quest.60B80CDE4193ED79.quest_desc: [
		"A castle at the end of the world."
	]
	quest.60B80CDE4193ED79.title: "End Castle"
	quest.613B01F8E8BD828B.quest_desc: [
		"A walled fort. The illagers won't let you in politely."
	]
	quest.613B01F8E8BD828B.title: "Illager Fort"
	quest.6197ED624AE5FF2A.quest_desc: [
		"A backpack is the best friend of an explorer. Upgrade it later."
	]
	quest.6197ED624AE5FF2A.title: "Pack Your Bags"
	quest.61E29E4B52BE17CA.quest_desc: [
		"Supplementaries: carry things, store fireflies, decorate."
	]
	quest.61E29E4B52BE17CA.title: "Sacks and Jars"
	quest.62BB24BE88E916DA.quest_desc: [
		"Defeat the Harbinger."
		"This is the end of Act II. The Nether is open: Act III starts now."
		""
		"&eReward:&r you learn &6Tempering VI&r and get your first Tempering Kit VI."
		"From now on you can craft that kit and temper any weapon or staff up to level VI."
	]
	quest.62BB24BE88E916DA.quest_subtitle: "Learn Tempering VI"
	quest.62BB24BE88E916DA.title: "&6Trial of Phase 6"
	quest.634168CDBA6D061F.quest_desc: [
		"Double your ores, and get extra goodies from gravel."
	]
	quest.634168CDBA6D061F.title: "Crushing Wheels"
	quest.634892C2AFC35058.quest_desc: [
		"Land on the main island. The obsidian towers hold End Crystals that heal the dragon."
		"Break them first. Some are in iron cages: you'll have to climb."
	]
	quest.634892C2AFC35058.title: "The Dragon's Island"
	quest.6419ECB7D8BFAA2A.quest_desc: [
		"Saws cut whole trees at once."
	]
	quest.6419ECB7D8BFAA2A.title: "Tree Farm"
	quest.64383F64D9FF7C1F.quest_desc: [
		"More glyphs per spell."
	]
	quest.64383F64D9FF7C1F.title: "&dArs:&r Apprentice Spell Book"
	quest.647EE7319945CCCE.quest_desc: [
		"Under the desert lies the tomb of a king. You need the &eNecklace of the Desert&r to wake him."
		"...or an Echo."
	]
	quest.647EE7319945CCCE.title: "The Cursed Pyramid"
	quest.654356F8CDAC9C3F.quest_desc: [
		"&eFarmer's Delight&r is the heart of cooking here. A cooking pot over a fire or stove makes soups and meals."
		"A cutting board and a knife slice ingredients. Meals give long-lasting buffs (Nourishment, Comfort)."
		"AppleSkin shows how filling each food is."
	]
	quest.654356F8CDAC9C3F.title: "&eA Real Kitchen"
	quest.665C2FD14970862F.quest_desc: [
		"Purple and blue flowers hanging from every branch."
	]
	quest.665C2FD14970862F.title: "Wisteria Forest"
	quest.66C1BDB4942F94FE.quest_desc: [
		"The Harbinger is down and the Nether is open for everyone. Light a portal."
		"Bring fire resistance potions, a shield and gold armor (piglins leave you alone if you wear gold)."
		"Incendium made the Nether a lot wilder than you remember."
	]
	quest.66C1BDB4942F94FE.title: "Into the Nether"
	quest.66EAEF7E688F4662.quest_desc: [
		"Someone already killed the boss you need? No problem."
		"Every quest boss has a craftable &dEcho&r. Right-click it where that boss lives (Overworld, Nether or End) to call it to you."
		"Echoes need an &dEcho Shard&r, which you'll find in Ancient Cities (Phase 3). See JEI for recipes."
	]
	quest.66EAEF7E688F4662.title: "&dBoss Echoes"
	quest.6730F19A5ABCCE10.quest_desc: [
		"Control machines from a distance with redstone links."
	]
	quest.6730F19A5ABCCE10.title: "Linked Controller"
	quest.67418D77FD6D64B8.quest_desc: [
		"Pink petals everywhere."
	]
	quest.67418D77FD6D64B8.title: "Sakura Grove"
	quest.67DEDBF9C94A7D3A.quest_desc: [
		"Older than the mineshafts."
	]
	quest.67DEDBF9C94A7D3A.title: "Ancient Mines"
	quest.6841F030B3C6A43B.quest_desc: [
		"Red vines and a deep valley."
	]
	quest.6841F030B3C6A43B.title: "Weeping Valley"
	quest.68CD47616C436C20.quest_desc: [
		"Ice caves under the snow. Bring a warm coat."
	]
	quest.68CD47616C436C20.title: "Frosted Caves"
	quest.698E29B020580AEE.quest_desc: [
		"Create's logistics: order anything from your storage and have it delivered."
	]
	quest.698E29B020580AEE.title: "Stock and Packages"
	quest.6A09BEC0D14488F4.quest_desc: [
		"Nothing in here is what it looks like."
	]
	quest.6A09BEC0D14488F4.title: "Illusioner Tower"
	quest.6B07D38FE3D375B0.quest_desc: [
		"An Echo of Ignis or of the Netherite Monstrosity calls them again, but only in the Nether."
		"Late joiners: ask a friend who has fought them to come along."
	]
	quest.6B07D38FE3D375B0.title: "&dNether Echoes"
	quest.6BFE38B0FFA293EA.quest_desc: [
		"Captain Cornelia's frozen ship. Find it in the icy seas."
	]
	quest.6BFE38B0FFA293EA.title: "Ice Maze Pirate Ship"
	quest.6C380F39401324F2.quest_desc: [
		"Brass needs &oheated&r mixing, which normally means a blaze."
		"The Nether is sealed, so this pack has an Overworld recipe for the &6Blaze Burner&r:"
		"an empty burner (iron plates and magma) plus magma blocks, lava and coal. Check JEI."
		"Zinc ore is found in the Overworld; copper you know."
	]
	quest.6C380F39401324F2.title: "&6Create:&r Brass"
	quest.6C6C1CFD85E7F7C6.quest_desc: [
		"More health."
	]
	quest.6C6C1CFD85E7F7C6.title: "Crystal Heart"
	quest.6C937FA5947E8982.quest_desc: [
		"Masked warriors guard a grove in the savanna. Their chief wears the mask of the sun."
	]
	quest.6C937FA5947E8982.title: "Umvuthana Grove"
	quest.6DA1CF5749944F50.quest_desc: [
		"Fat trees that look like they're upside down."
	]
	quest.6DA1CF5749944F50.title: "Baobab Savanna"
	quest.6E083910D9248137.quest_desc: [
		"Puzzles, traps and treasure under the vines."
	]
	quest.6E083910D9248137.title: "Jungle Temple"
	quest.6E2A0C3361D5F849.quest_desc: [
		"Home of the phantoms."
	]
	quest.6E2A0C3361D5F849.title: "Phantom Citadel"
	quest.6E31B51B1F1485AC.quest_desc: [
		"There is no portal home. Not yet."
		"Old stories talk about a &dReturn Gate&r: purpur and shells, pearls, and the head of a dragon"
		"that never lived. Only someone who has beaten the Ender Guardian can wake it."
	]
	quest.6E31B51B1F1485AC.title: "How do we get back?"
	quest.6E937C72C722ACFB.quest_desc: [
		"&aBoss credit is shared:&r everyone within 64 blocks when a boss dies gets credit for it."
		"&aBosses scale:&r more players means each hit does a bit less, so a group still gets a real fight."
		"&aLoot is per player:&r every chest has its own loot for each player (Lootr). Latecomers still find loot."
		"&aGraves:&r if you die, your items wait in a grave."
		""
		"Want to share quest progress with a friend? Make a party: &e/ftbteams party create&r."
	]
	quest.6E937C72C722ACFB.title: "Play together"
	quest.6EAD1613082815D5.quest_desc: [
		"Layers of colored sandstone."
	]
	quest.6EAD1613082815D5.title: "Stratified Desert"
	quest.6F17FC1A0D317A1F.quest_desc: [
		"Sand caves under the desert, full of old secrets."
	]
	quest.6F17FC1A0D317A1F.title: "Lost Caves"
	quest.6F1E81BC14E5448F.quest_desc: [
		"Copper, breezes and trial keys."
	]
	quest.6F1E81BC14E5448F.title: "Trial Chambers"
	quest.6F7732C9AFDD4A18.quest_desc: [
		"The biggest castle in the Nether. Forbidden for a reason."
	]
	quest.6F7732C9AFDD4A18.title: "The Forbidden Castle"
	quest.701E86015077FAFC.quest_desc: [
		"Chalk cliffs over the sea."
	]
	quest.701E86015077FAFC.title: "White Cliffs"
	quest.71396FFE00597E8A.quest_desc: [
		"Beat &etwo&r of the four far-land bosses: Frostmaw, Umvuthi, Maledictus or the Ancient Remnant."
		""
		"&eReward:&r you learn &6Tempering IV&r and get your first Tempering Kit IV."
		"From now on you can craft that kit and temper any weapon or staff up to level IV."
	]
	quest.71396FFE00597E8A.quest_subtitle: "Learn Tempering IV"
	quest.71396FFE00597E8A.title: "&6Trial of Phase 4"
	quest.71C2D51A9756F916.quest_desc: [
		"The illagers built a maze. Of course they did."
	]
	quest.71C2D51A9756F916.title: "Illager Labyrinth"
	quest.720BBE61DE8A3CCB.quest_desc: [
		"A whole city of nether brick."
	]
	quest.720BBE61DE8A3CCB.title: "Nether City"
	quest.7275A531BCEB8A54.quest_desc: [
		"The Slicer uses a knife on a cutting board for you. The Sprinkler waters your farm."
	]
