	]
	quest.2FF69A890A608FE6.title: "Item Vault"
	quest.300A1160893400D8.quest_desc: [
		"Hold many kinds of arrows at once."
	]
	quest.300A1160893400D8.title: "Quiver"
	quest.304EE32ED1CAB9C2.quest_desc: [
		"Green, glowing and poisonous."
	]
	quest.304EE32ED1CAB9C2.title: "Toxic Heap"
	quest.307A7FB4B1ECDB04.quest_desc: [
		"Even ships in the void can sink."
	]
	quest.307A7FB4B1ECDB04.title: "End Shipwreck"
	quest.3236A73465D211DF.quest_desc: [
		"Read the &eWorn Notebook&r. Glyphs are crafted at the Scribe's Table and put into your spell book."
	]
	quest.3236A73465D211DF.title: "&dArs Nouveau"
	quest.32E45504E6286C4C.quest_desc: [
		"Cold, flat and very windy."
	]
	quest.32E45504E6286C4C.title: "Tundra"
	quest.33835BAE2EFAE768.quest_desc: [
		"Four great enemies live far from spawn: in the ice, in the jungle, in the frozen peaks and in the desert."
		"&eYou only need to beat two of them&r to pass this Phase. Pick the trips that sound fun."
		"Now is a good time for a train line or a waystone network."
	]
	quest.33835BAE2EFAE768.title: "Expedition"
	quest.33AA8CFBBDCD3ABD.quest_desc: [
		"A keg ferments drinks: beer, mead, rice wine... and makes cheese too."
	]
	quest.33AA8CFBBDCD3ABD.title: "Brewin' and Chewin'"
	quest.33AC20A0A3B03A65.quest_desc: [
		"Chaos spills out of this tower at night."
	]
	quest.33AC20A0A3B03A65.title: "Dark Tower"
	quest.33B2AAE833BE009F.quest_desc: [
		"Something is still running in here."
	]
	quest.33B2AAE833BE009F.title: "Nether Reactor"
	quest.34395F9052A26317.quest_desc: [
		"A skeleton mage that calls more skeletons."
	]
	quest.34395F9052A26317.title: "Supreme Bonescaller"
	quest.346495447F1F7F11.quest_desc: [
		"It helps your plants grow."
	]
	quest.346495447F1F7F11.title: "&dArs:&r Whirlisprig"
	quest.34A9BCAF72192C47.quest_desc: [
		"Build an airship that can cross the void: lift, propellers, fuel, and a place to land."
		"Bring blocks, food and your whole team. Ponder (&eW&r) shows how the parts work."
		"Levitite (check JEI) makes things float."
	]
	quest.34A9BCAF72192C47.title: "&6Create:&r An End Airship"
	quest.366D7302AFE1D480.quest_desc: [
		"The last boss. Everyone within 64 blocks gets credit."
		"When it dies, the void winds calm down and wings work everywhere in the End."
	]
	quest.366D7302AFE1D480.title: "&cBoss: The Ender Dragon"
	quest.368C5ABDFF0A22AB.quest_desc: [
		"Let's Do Vinery: plant grapevines on a trellis, then press and ferment them into wine."
	]
	quest.368C5ABDFF0A22AB.title: "The Vineyard"
	quest.371B53B968E6CA34.quest_desc: [
		"Illager Invasion's Imbuing Table pushes an enchantment one level past its normal max."
