	quest.2F37ACE67A731F1F.title: "Jacaranda Jungle"
	quest.2F40B36A15B5FC50.quest_desc: [
		"White trunks and golden leaves."
	]
	quest.2F40B36A15B5FC50.title: "Aspen Forest"
	quest.2F436E4EB7868DE2.quest_desc: [
		"Prove the ruins are yours. Defeat 5 vindicators and have 16 brass ingots."
		""
		"&eReward:&r you learn &6Tempering II&r and get your first Tempering Kit II."
		"From now on you can craft that kit and temper any weapon or staff up to level II."
	]
	quest.2F436E4EB7868DE2.quest_subtitle: "Learn Tempering II"
	quest.2F436E4EB7868DE2.title: "&6Trial of Phase 2"
	quest.2F58F09C3B139A1B.quest_desc: [
		"An illager fortress full of evokers and their spells. Great loot for casters."
