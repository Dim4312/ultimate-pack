	quest.37D0E5A084DA15A8.title: "&6Create:&r Trains"
	quest.37E949A8A26EAE0A.quest_desc: [
		"Huge pillars with gardens on top."
	]
	quest.37E949A8A26EAE0A.title: "Crag Gardens"
	quest.3818CFCC5D58C03A.quest_desc: [
		"A real castle, walls and all."
	]
	quest.3818CFCC5D58C03A.title: "The Castle"
	quest.38482C831C621CA3.quest_desc: [
		"Rustic Delight adds coffee and bell peppers; Expanded Delight adds chili, peanuts, cinnamon and cheese."
	]
	quest.38482C831C621CA3.title: "Spice it Up"
	quest.3860CDE5C0DA1641.quest_desc: [
		"Upgrade your backpack: more slots, then magnets, feeders and more."
	]
	quest.3860CDE5C0DA1641.title: "Better Backpack"
	quest.38850715B2AA5D94.quest_desc: [
		"Manors, hideouts, mansions. The illagers have more than outposts."
		"Evokers drop totems of undying. You'll want some later."
	]
	quest.38850715B2AA5D94.title: "Illager Strongholds"
	quest.38D4C8F02F2CFD21.quest_desc: [
		"The cursed warrior. Fast, deadly and loud. Bring shields and friends."
	]
	quest.38D4C8F02F2CFD21.title: "&cBoss: Maledictus"
	quest.391FC3F74C0C2F45.quest_desc: [
		"Punch a tree, make a crafting table. Every great base starts this way."
		"Look around. Can you see a village, a tower, a ruin? Remember it."
	]
	quest.391FC3F74C0C2F45.title: "A Place to Start"
	quest.3949A5E65E1958EA.quest_desc: [
		"Chorus, shulker meat and even dragon. Cook on an End stove."
	]
	quest.3949A5E65E1958EA.title: "&5End's Delight"
	quest.397204955D0BF79E.quest_desc: [
		"Spires of crystal on the outer islands."
	]
	quest.397204955D0BF79E.title: "Crystal Peaks"
	quest.39DC552F5B5E97A5.quest_desc: [
		"A knight in black armor."
	]
	quest.39DC552F5B5E97A5.title: "Fallen Chaos Knight"
	quest.39ECAB3AE1AFB2ED.quest_desc: [
		"Precision mechanisms come from sequenced assembly: a chain of deployers and a press."
		"If you've built that line, you're ready for the factory."
	]
	quest.39ECAB3AE1AFB2ED.title: "Precision"
	quest.3A247C25BCBBFB63.quest_desc: [
		"Not quest bosses, but they drop great stuff. Shared credit doesn't apply here: everyone wants the loot."
	]
	quest.3A247C25BCBBFB63.title: "&cMini-Bosses"
	quest.3A5349211566D9FF.quest_desc: [
		"Make source from growing plants, fire, mushrooms or potions."
	]
	quest.3A5349211566D9FF.title: "&dArs:&r Sourcelinks"
	quest.3A61AD421B7825F9.quest_desc: [
		"With Create Aeronautics you can build a flying ship: an envelope or propellers to lift it,"
		"a propeller bearing to push it, and a Physics Assembler to bring it to life."
		"Ponder (&eW&r) shows how. An airship makes the sea a lot friendlier."
	]
	quest.3A61AD421B7825F9.title: "&6Create:&r First Airship"
	quest.3AC278343CFDF3D5.quest_desc: [
		"Wandering wizards and tower mages carry spell scrolls and arcane essence."
		"Some are friendly, some are not. Pyromancers and cryomancers live in their towers."
	]
	quest.3AC278343CFDF3D5.title: "&9Magic:&r Wizard Towers"
	quest.3B4DCB310F4D7421.quest_desc: [
		"A huge temple under the sand. Watch out for traps and the pharaoh's curse (mining fatigue)."
		"Break the seals to lift it."
	]
	quest.3B4DCB310F4D7421.title: "Desert Temple"
	quest.3C568B0D252C8D7E.quest_desc: [
		"Climb down and pull things up."
	]
	quest.3C568B0D252C8D7E.title: "Rope"
	quest.3C5CADF2C25E4756.quest_desc: [
		"&6Tempering&r gives a weapon or staff &e+12% damage&r and &e+6% spell power&r per level."
		""
		"1. Beat a Phase &6Trial&r. You &olearn&r that Tempering level forever."
		"2. Craft a &6Tempering Kit&r of that level (normal materials, see JEI)."
		"3. Hold the weapon in one hand and the kit in the other, then right-click."
		""
		"Found a cooler sword later? Temper it too. Your knowledge stays, a kit only costs materials."
		"No grinding, no random rolls. Tempering X is about 2.2x damage, and that's the cap."
	]
	quest.3C5CADF2C25E4756.title: "&6Tempering"
	quest.3D2502FE71E7408B.quest_desc: [
		"Blaze powder and ender pearls. Throw an eye and follow it to a stronghold."
	]
	quest.3D2502FE71E7408B.title: "Eyes of Ender"
	quest.3DACB7349E294F1A.quest_desc: [
		"Yes, it shoots potatoes. Yes, it hurts."
	]
	quest.3DACB7349E294F1A.title: "Potato Cannon"
	quest.3DE67754D3941A50.quest_desc: [
		"Dark land under a dark sky."
	]
	quest.3DE67754D3941A50.title: "Shadowlands"
	quest.3E3F5106478640C8.quest_desc: [
		"Craft the gate (see JEI) and place it at your End base."
	]
	quest.3E3F5106478640C8.title: "Build the Return Gate"
	quest.3E53904F5676765C.quest_desc: [
		"Put them on a moving contraption and drive over your fields."
	]
	quest.3E53904F5676765C.title: "Automatic Farm"
	quest.3EA0575DE92FA552.quest_desc: [
		"Double jump!"
	]
	quest.3EA0575DE92FA552.title: "Cloud in a Bottle"
